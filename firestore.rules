rules_version = '2';

// Three things live in this project: one document per signed-in user holding
// that user's saved profiles and their stills; bender's saved voices, from a
// second app that shares the project; and reports of recordings that failed.
// `deploy.yml` sends this file when a push to main changes it;
// `pnpm firebase-deploy` sends it by hand.
//
// Default deny: this file grants access to the paths matched below and no
// others. Those are `users/{uid}` and its `stills`, `benderUsers/{uid}` and
// `takeReports`. Every other collection in the project, including any added
// later without a rule of its own, is denied.
//
// Private, unlike the presence collection in phyloguessr: a saved profile is a
// look somebody dialed in, and nobody but its author has any business reading
// the list. `request.auth.uid == uid` makes the document path the authorization,
// and no code in the app queries across users, so no rule needs to allow one.
//
// The known limit of these rules: `profiles` is a list, and rules cannot iterate
// a list, so the *shape of each entry* is not validated here — only that the
// document has that one field, that it is a list, and that it is not enormous.
// The client sanitizes every entry on the way in (readProfiles in
// savedProfiles.ts drops anything that is not {name, query} strings), which
// protects this app's users from a bad document but would not stop someone
// writing junk into their own. Storing one document per profile would let rules
// check each entry, and it was not chosen for a reason worth knowing: a
// collection has no order, and the list's insertion order is what makes it
// readable by eye mid-set.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Both creates and updates go through this, as the same one write: the app
    // always sends the whole list. 200 entries is far past what the popover can
    // be scrolled through, and it is the guard that stops a bug — or a
    // hand-rolled request — pushing an unbounded document into the project and
    // billing it to whoever owns these rules.
    //
    // Every field is optional because the app writes them with merge, each
    // from its own path: the session autosave can land before the first profile
    // is ever saved, and a profile save must leave the sessions as it found
    // them. `recent` is the autosaved sessions, newest first, each an id, the
    // same packed query a profile holds, and a clock; a list, so its entries go
    // unchecked like the profiles'. `current` is the single session older builds
    // wrote — the same query and clock — or null once cleared. 1000 sessions is
    // the app's own history cap (RECENT_MAX in profileModel.ts); the entries are
    // usually a packed query of tens to a few hundred bytes, well under the 1
    // MiB document even at that count.
    function isValidProfileDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly(['profiles', 'recent', 'current'])
             && (!('profiles' in data)
                 || (data.profiles is list && data.profiles.size() <= 200))
             && (!('recent' in data)
                 || (data.recent is list && data.recent.size() <= 1000))
             && (!('current' in data)
                 || data.current == null
                 || (data.current is map
                     && data.current.keys().hasOnly(['query', 'at'])
                     && data.current.query is string
                     && data.current.query.size() <= 8000
                     && data.current.at is number));
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfileDoc();
      // Signing out does not delete anything, and nothing in the app deletes the
      // document — clearing the last profile writes an empty list. The rule
      // exists so the owner is not locked out of removing their own data.
      //
      // Deleting the account itself takes this document and its stills with it:
      // the delete-user-data extension (firebase.json, configured in
      // extensions/delete-user-data.env) watches Firebase Auth deletions and
      // removes `users/{uid}` and `benderUsers/{uid}` recursively.
      allow delete: if isOwner(uid);
      // No `list`: there is no query over /users, and allowing one would let any
      // signed-in user enumerate the collection.

      // One still per saved profile, keyed by the profile's id: a small webp as
      // base64, the clock it was taken at, and optionally `q`, the board it is
      // a picture of. Its own collection because the user document is capped at
      // 1 MiB and two hundred stills would pass it. `list` is allowed here and
      // not on /users because the path binds the uid, so the query can only
      // ever be over one person's own stills.
      function isValidStill() {
        let data = request.resource.data;
        return data.keys().hasOnly(['webp', 'at', 'q'])
               && data.webp is string
               && data.webp.size() <= 60000
               && data.at is number
               && (!('q' in data) || (data.q is string && data.q.size() <= 16));
      }

      match /stills/{stillId} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidStill();
        allow delete: if isOwner(uid);
      }
    }

    // --- bender (github.com/cmdcolin/bender) ---
    //
    // A second app on the same project: a web circuit-bending synth whose saved
    // boards are voices. It shares the project so Google sign-in and the
    // authorized domains are set up once, and its rules live here because a
    // project has one rules file. The document is the same shape as /users
    // with `voices` for `profiles`, and no stills: a board has no picture.
    //
    // `prefs` is the setup rather than the sound: how the instruments sit, how
    // long a new board takes to arrive, which computer keys play what. A map,
    // so unlike the lists its keys and value types are checked here. `at` is
    // the clock of the last change, which is how two machines pick a winner;
    // `bench.closed` and `keys` are lists, so their entries are the client's to
    // sanitise.
    function isValidPrefs(prefs) {
      return prefs is map
             && prefs.keys().hasOnly(['at', 'bench', 'morph', 'keys'])
             && prefs.at is number
             && (!('bench' in prefs)
                 || (prefs.bench is map
                     && prefs.bench.keys().hasOnly(['all', 'closed'])
                     && prefs.bench.all is bool
                     && prefs.bench.closed is list
                     && prefs.bench.closed.size() <= 8))
             && (!('morph' in prefs) || prefs.morph in [0, 1, 4, 8, 30])
             && (!('keys' in prefs)
                 || (prefs.keys is list && prefs.keys.size() <= 64));
    }

    function isValidVoiceDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly(['voices', 'recent', 'current', 'prefs'])
             && (!('prefs' in data) || isValidPrefs(data.prefs))
             && (!('voices' in data)
                 || (data.voices is list && data.voices.size() <= 200))
             && (!('recent' in data)
                 || (data.recent is list && data.recent.size() <= 8))
             && (!('current' in data)
                 || data.current == null
                 || (data.current is map
                     && data.current.keys().hasOnly(['query', 'at'])
                     && data.current.query is string
                     && data.current.query.size() <= 8000
                     && data.current.at is number));
    }

    match /benderUsers/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidVoiceDoc();
      allow delete: if isOwner(uid);
    }

    // A recording that failed or crashed its page, as src/ui/takeLog.ts sends
    // it. The one collection a visitor writes without signing in, since a take
    // needs no account, so the shape check is all that stands here: every
    // field is named, typed and capped. A script can still write rows, and the
    // hourly digest in functions/ caps what that costs to one email an hour.
    function optString(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }
    function optNumber(d, k) {
      return !(k in d) || d[k] is number;
    }
    function isValidTakeReport() {
      let d = request.resource.data;
      return d.keys().hasOnly(
               ['kind', 'version', 'browser', 'page', 'width', 'height', 'fps',
                'codec', 'hardware', 'seconds', 'frames', 'held', 'deepest',
                'encoded', 'chunks', 'bytes', 'configs', 'coded', 'canvas', 'error',
                'stage', 'hidden', 'streamed', 'message', 'model', 'memory',
                'sat'])
             && d.kind in ['lost', 'failed']
             && d.version is string && d.version.size() <= 32
             && d.browser is string && d.browser.size() <= 200
             && optString(d, 'page', 64)
             && optString(d, 'codec', 32)
             && optString(d, 'hardware', 8)
             && optString(d, 'stage', 16)
             && optString(d, 'message', 100)
             && optString(d, 'error', 32)
             && optString(d, 'coded', 16)
             && optString(d, 'canvas', 16)
             && optString(d, 'model', 64)
             && optNumber(d, 'width')
             && optNumber(d, 'height')
             && optNumber(d, 'fps')
             && optNumber(d, 'seconds')
             && optNumber(d, 'frames')
             && optNumber(d, 'held')
             && optNumber(d, 'deepest')
             && optNumber(d, 'encoded')
             && optNumber(d, 'chunks')
             && optNumber(d, 'bytes')
             && optNumber(d, 'configs')
             && optNumber(d, 'memory')
             && (!('hidden' in d) || d.hidden is bool)
             && (!('streamed' in d) || d.streamed is bool)
             && d.sat == request.time;
    }

    match /takeReports/{reportId} {
      allow create: if isValidTakeReport();
    }
  }
}
