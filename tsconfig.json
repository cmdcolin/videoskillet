{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "es2023.array", "esnext.iterator"],
    "types": ["@webgpu/types", "vite/client", "node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // Free: every import in the tree already says `import type` where it means
    // one, so this costs nothing today and stops the convention drifting. It
    // also removes the guesswork isolatedModules otherwise leaves a bundler —
    // an elided import is elided because the source said so, not because a
    // transpiler inferred it.
    "verbatimModuleSyntax": true,
    // `scripts/demos.mjs` is the demo list and `scripts/reel.mjs` the carousel's
    // slides, and the landing-page tests that read them are the only things in
    // `src/` that import out of `scripts/`. Inferring their shape from the
    // modules themselves keeps that shape in one place.
    "allowJs": true
  },
  // Everything, tests included, with node's globals for the third of the tests
  // that shell out or read files. Editors and oxlint's type-aware rules find
  // this file, so it has to cover the tests: a file outside it gets checked with
  // default options. tsconfig.app.json checks the app again without node.
  "include": ["src", "site/**/*.ts"],
  "exclude": ["site/**/*.test.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
