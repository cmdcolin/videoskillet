---
import { getCollection, render } from 'astro:content'

import Page from '../layouts/Page.astro'
import { ALL } from '../lib/pages.mjs'

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  return ALL.map(spec => ({
    params: { page: spec.slug },
    props: { spec, entry: docs.find(doc => doc.id === spec.id) },
  }))
}

const { spec, entry } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(entry)
---

<Page
  spec={spec}
  outline={remarkPluginFrontmatter.outline}
  summary={remarkPluginFrontmatter.summary}
>
  <Content />
</Page>
