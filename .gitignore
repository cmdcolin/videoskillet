.DS_Store
node_modules/
dist/
# astro's generated types and content cache
.astro/
# git worktree copies other agents work in — full checkouts, never committed
.claude/worktrees/
*.tsbuildinfo
clips/
# contact sheets from scripts/contact.mjs — a working artifact of one screening
# round, regenerated per round and superseded by whichever candidates ship
docs/contact/
# firebase CLI working files. Note there is no .env to ignore: the web config is
# public and committed in src/ui/cloud.ts — see docs/adr/0005.
.firebase/
firebase-debug.log
firestore-debug.log

# what scripts/panelshots.mjs writes beside a baseline when a shot drifts, so
# the two can be opened side by side. A failure artifact, rewritten by the next
# failing run and stale the moment the baseline is regenerated — six of them
# were committed once and outlived the drift they were evidence of.
scripts/panelshots/*.actual.png

# the carousel's clips go to s3://myloveydove.com/videoskillet/reel/ at the end of a
# take (scripts/appreel.mjs); the stills beside them stay
public/reel/*.mp4

# and the gallery's to s3://myloveydove.com/videoskillet/demos/ (scripts/demoreel.mjs),
# for the same reason: a moving picture re-recorded whenever its look changes is
# a file a git history keeps every version of forever
public/demos/*.mp4

# The offline renderer bundles the engine to run it without a bundler; the
# bundle is a build product of src/ and is rebuilt by `pnpm render`.
scripts/render/build/

# Watchable copies of the doc figures (node scripts/renderdocs.mjs --keep).
# Same rule as the reel and the demos: the stills are committed, the clips are
# not.
renders/

# The JSR package is src/core restaged so it resolves without Vite
# (scripts/jsrpack.mjs). A build product, like scripts/render/build.
/jsr/

# The compiled offline renderer (pnpm render:compile) — a build product.
/bin/

# Cross-compiled renderer binaries (node scripts/render/compile.mjs --all).
/dist-bin/
