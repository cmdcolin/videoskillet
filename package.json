{
  "name": "videoskillet",
  "private": true,
  "version": "2.25.5",
  "description": "Real-time NTSC / VHS / composite-video glitch simulator in WebGPU compute shaders.",
  "license": "MIT",
  "homepage": "https://videoskillet.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmdcolin/videoskillet.git"
  },
  "keywords": [
    "webgpu",
    "ntsc",
    "vhs",
    "composite-video",
    "analog-video",
    "crt",
    "glitch",
    "video-synth",
    "wgsl",
    "compute-shader"
  ],
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsrs -b && node scripts/docgen.mjs --check && astro build",
    "preview": "astro preview",
    "format": "oxfmt && prettier --write \"site/**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"site/**/*.astro\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "compiler": "node scripts/compilercheck.mjs",
    "typecheck": "tsrs -b && tsrs --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "harnesses": "node scripts/sweep.mjs",
    "gpuprof": "deno run -A --config scripts/gpuprof/deno.json scripts/gpuprof/main.ts",
    "render": "vite build --config vite.render.config.ts && deno run -A --config scripts/gpuprof/deno.json scripts/render/main.ts",
    "render:build": "vite build --config vite.render.config.ts",
    "render:golden": "node scripts/render/lavapipe.mjs scripts/render/golden.ts",
    "render:determinism": "node scripts/render/lavapipe.mjs scripts/render/determinism.ts",
    "serve": "deno run -A --config scripts/gpuprof/deno.json scripts/render/main.ts serve",
    "render:compile": "node scripts/render/compile.mjs",
    "render:docs": "node scripts/renderdocs.mjs",
    "render:docs:keep": "node scripts/renderdocs.mjs --keep",
    "render:docs:check": "node scripts/renderdocs.mjs --check",
    "gpuprof:cmp": "deno run -A scripts/gpuprof/cmp.ts",
    "version": "git-cliff --tag v$npm_package_version -o CHANGELOG.md && git add CHANGELOG.md",
    "pat": "node scripts/push.mjs patch",
    "min": "node scripts/push.mjs minor",
    "maj": "node scripts/push.mjs major",
    "ship": "node scripts/push.mjs none",
    "logo": "node scripts/logo.mjs",
    "icons": "node scripts/icons.mjs",
    "docshots": "node scripts/docshots.mjs",
    "docshots:check": "node scripts/docshots.mjs --check",
    "callout": "node scripts/callout.mjs",
    "homeshot": "node scripts/homeshot.mjs",
    "heroplate": "node scripts/heroplate.mjs",
    "heroplate:check": "node scripts/heroplate.mjs --check",
    "buttonplate": "node scripts/buttonplate.mjs",
    "guide": "astro build",
    "blog:draft": "node scripts/blogdraft.mjs",
    "docgen": "node scripts/docgen.mjs",
    "docgen:check": "node scripts/docgen.mjs --check",
    "demoreel": "node scripts/demoreel.mjs",
    "reel": "node scripts/appreel.mjs",
    "reel:check": "node scripts/appreel.mjs --check",
    "agentreel": "node scripts/agentreel.mjs",
    "guide:check": "astro build && node scripts/guidecheck.mjs",
    "distcheck": "node scripts/distcheck.mjs",
    "sync:check": "node scripts/sync-check.mjs",
    "homewait": "node scripts/homewait.mjs",
    "jsr": "node scripts/jsrpack.mjs",
    "jsr:check": "node scripts/jsrpack.mjs && cd jsr && deno publish --dry-run --allow-dirty",
    "jsr:publish": "node scripts/jsrpack.mjs && cd jsr && deno publish --allow-dirty",
    "firebase-deploy": "firebase deploy --only firestore:rules",
    "firebase-deploy:functions": "firebase deploy --only functions",
    "test:rules": "firebase emulators:exec --only firestore --project ntscjs-rules-test \"vitest run firestoreRules && vitest run --root functions\"",
    "docs": "node scripts/diagrams.mjs",
    "docs:check": "node scripts/diagrams.mjs --check",
    "blog:maps": "node scripts/blogmaps.mjs",
    "blog:maps:check": "node scripts/blogmaps.mjs --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint --no-error-on-unmatched-pattern",
      "oxfmt --check"
    ],
    "*.astro": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "@astrojs/react": "^7.1.7",
    "firebase": "13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skillet-shared": "^0.9.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.7",
    "@babel/core": "^8.1.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@webgpu/types": "^0.1.74",
    "astro": "^7.4.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "firebase-tools": "^15.35.0",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "markdown-it": "^15.0.3",
    "oxc-transform-react": "^0.158.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "^1.1.2",
    "puppeteer-core": "^25.17.0",
    "rehype-raw": "^7.0.0",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
