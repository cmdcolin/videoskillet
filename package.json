{
  "name": "videoskillet.js",
  "private": true,
  "version": "0.37.1",
  "description": "Real-time NTSC / VHS / composite-video glitch simulator in WebGPU compute shaders.",
  "license": "MIT",
  "homepage": "https://videoskillet.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmdcolin/videoskillet.git"
  },
  "keywords": [
    "webgpu",
    "ntsc",
    "vhs",
    "composite-video",
    "analog-video",
    "crt",
    "glitch",
    "video-synth",
    "wgsl",
    "compute-shader"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/docgen.mjs --check && node scripts/demogen.mjs --check && node scripts/build-guide.mjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "compiler": "node scripts/compilercheck.mjs",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "harnesses": "node scripts/sweep.mjs",
    "gpuprof": "deno run -A --config scripts/gpuprof/deno.json scripts/gpuprof/main.ts",
    "gpuprof:cmp": "deno run -A scripts/gpuprof/cmp.ts",
    "version": "git-cliff --tag v$npm_package_version -o CHANGELOG.md && git add CHANGELOG.md",
    "pat": "node scripts/push.mjs patch",
    "min": "node scripts/push.mjs minor",
    "maj": "node scripts/push.mjs major",
    "logo": "node scripts/logo.mjs",
    "icons": "node scripts/icons.mjs",
    "docshots": "node scripts/docshots.mjs",
    "docshots:check": "node scripts/docshots.mjs --check",
    "callout": "node scripts/callout.mjs",
    "og": "node scripts/ogimage.mjs",
    "guide": "node scripts/build-guide.mjs",
    "docgen": "node scripts/docgen.mjs",
    "docgen:check": "node scripts/docgen.mjs --check",
    "demos": "node scripts/demogen.mjs",
    "demos:check": "node scripts/demogen.mjs --check",
    "demoreel": "node scripts/demoreel.mjs",
    "reel": "node scripts/appreel.mjs",
    "reel:check": "node scripts/appreel.mjs --check",
    "guide:check": "node scripts/build-guide.mjs && node scripts/guidecheck.mjs",
    "firebase-deploy": "firebase deploy --only firestore:rules",
    "test:rules": "firebase emulators:exec --only firestore --project ntscjs-rules-test \"vitest run firestoreRules\"",
    "docs": "node scripts/diagrams.mjs",
    "docs:check": "node scripts/diagrams.mjs --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt"
    ]
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.72",
    "babel-plugin-react-compiler": "^1.0.0",
    "firebase-tools": "^15.28.2",
    "git-cliff": "^2.13.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markdown-it": "^15.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "puppeteer-core": "^25.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
