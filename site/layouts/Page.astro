---
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import spy from '../scripts/spy.js?raw'
import tabs from '../scripts/tabs.js?raw'
import video from '../scripts/video.js?raw'
import css from '../styles/guide.css?raw'
import tokens from '../styles/tokens.css?raw'

import { href } from '../lib/pages.mjs'

const { spec, outline, summary } = Astro.props

const SITE = 'https://videoskillet.com'

// Short pages don't get a section nav — four sections you can see by scrolling
// are not worth one — but the effects page is 25,000 pixels tall on a phone.
const NAV_MIN = 5

const title = `${spec.nav} — videoskillet.js`
const canonical = SITE + href(spec.slug)
const pages = spec.group.pages
const at = pages.findIndex(page => page.slug === spec.slug)
const prev = pages[at - 1]
const next = pages[at + 1]
const marked = spec.group.mark(spec)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0e0e11" />
    <meta name="color-scheme" content="dark" />
    <!-- A guide page shared on its own unfurls as itself, not as a bare filename. -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="videoskillet.js" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content={`${SITE}/og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Inlined rather than linked: a handful of static pages, each one then
         self-contained enough to render opened straight off the filesystem,
         with no server to resolve a stylesheet path against. -->
    <style is:inline set:html={tokens + css}></style>
  </head>
  <body id="top">
    <a class="skip" href="#content">Skip to content</a>
    <Header
      label={spec.group.label}
      links={spec.group.nav.map(page => ({
        href: href(page.slug),
        nav: page.nav,
        on: page.slug === marked,
      }))}
    />
    <div class="wrap">
      {
        outline.length >= NAV_MIN && (
          <details class="toc">
            <summary>On this page</summary>
            <nav aria-label="On this page">
              {outline.map(head => (
                <a class={`l${head.level}`} href={`#${head.id}`}>
                  {head.text}
                </a>
              ))}
            </nav>
          </details>
        )
      }
      <main id="content">
        <slot />
        <nav class="pager" aria-label="Pages">
          {
            prev === undefined ? (
              <span />
            ) : (
              <a class="prev" href={href(prev.slug)}>
                <span>← Previous</span>
                <b>{prev.nav}</b>
              </a>
            )
          }
          {
            next === undefined ? (
              <span />
            ) : (
              <a class="next" href={href(next.slug)}>
                <span>Next →</span>
                <b>{next.nav}</b>
              </a>
            )
          }
        </nav>
      </main>
    </div>
    <Footer />
    <script is:inline set:html={spy} />
    <script is:inline set:html={video} />
    <script is:inline set:html={tabs} />
  </body>
</html>
