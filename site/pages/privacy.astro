---
// Two services and what each one is for. Short on purpose.
import Page from '../layouts/Page.astro'
import { ORIGIN } from '../lib/site'
import css from '../styles/landing.css?raw'

const NAME = 'videoskillet'
---

<Page
  title="Privacy — videoskillet"
  description="videoskillet uses Google Analytics to count visits and Firebase to store your saved looks and any ratings you give. Nothing else."
  css={css}
  canonical={`${ORIGIN}privacy/`}
  account={false}
>
  <main class="wrap privacy">
    <!-- CROSS_REPO_SYNC(privacy-analytics) -->
    <h1>Privacy</h1>
    <p class="privacyLead">
      We use Firebase for logins, and storing some of the settings you make
      there, and Google Analytics to see if anyone is actually using this. That
      is all. Please contact colin.diesh@gmail.com for concerns.
    </p>
  </main>

  <Fragment slot="scripts">
    <script>
      import { forgetAnalyticsAnswer } from '../../src/analytics'

      // CROSS_REPO_SYNC(privacy-analytics-reset)
      // A reload, so the notice asks again on a page that has not loaded the tag.
      document
        .getElementById('analyticsAgain')
        ?.addEventListener('click', () => {
          forgetAnalyticsAnswer()
          location.reload()
        })
      // CROSS_REPO_SYNC_END(privacy-analytics-reset)
    </script>
  </Fragment>
</Page>
