---
import Analytics from '../components/Analytics.astro'
import Footer from '../components/Footer.astro'
import SiteBar from '../components/SiteBar.astro'
import css from '../styles/landing.css?raw'
import designTokens from '../../src/tokens.css?raw'
import site from '../styles/site.css?raw'
import footer from '../styles/footer.css?raw'
import tokens from '../styles/tokens.css?raw'

// Two services and what each one is for. Short on purpose.
const SITE = 'https://videoskillet.com/'
const REPO = 'https://github.com/cmdcolin/videoskillet'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Privacy — videoskillet.js</title>
    <meta
      name="description"
      content="videoskillet uses Google Analytics to count visits and Firebase to store your saved looks and any ratings you give. Nothing else."
    />
    <link rel="canonical" href={`${SITE}privacy/`} />
    <meta name="theme-color" content="#0e0e11" />
    <meta name="color-scheme" content="dark" />
    <style
      is:inline
      set:html={designTokens + tokens + site + footer + css}
    ></style>
    <Analytics />
  </head>
  <body id="top">
    <SiteBar account={false} />

    <main class="wrap privacy">
      <h1>Privacy</h1>
      <p class="privacyLead">
        videoskillet runs in your browser. Two outside services are involved,
        and this page is the whole list.
      </p>

      <h2>Google Analytics</h2>
      <p>
        Counts visits: which pages get opened, roughly where from, and on what
        sort of device. It sets cookies to do that. Any tracker blocker switches
        it off, and everything here works the same without it.
      </p>

      <h2>Firebase</h2>
      <p>
        Only if you sign in. Google handles the sign-in, and your account's
        Firestore document holds your saved looks and the session you last had
        open, so the home page can offer it back. Each one records the look's
        settings, including the address of any video or image it loaded from a
        link, and a small still of the output is kept beside each.
      </p>
      <p>
        Rating a look in the tags menu, or voting on the labelling page, adds a
        row to a shared set of labels. Each row carries your account's id and
        the look it rates, and the site cannot change or delete a row once it is
        written. Stay signed out and nothing is stored at all.
      </p>

      <h2>Getting rid of it</h2>
      <p>
        <b>×</b> in the saved menu deletes a look and its still on the spot. To
        have your saved looks, your session and their stills deleted, say so in
        <a href={`${REPO}/issues`}>an issue</a>. Nothing is sold and there are
        no ads.
      </p>
    </main>

    <Footer />
  </body>
</html>
