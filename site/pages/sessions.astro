---
import Page from '../layouts/Page.astro'
import { ORIGIN } from '../lib/site'
import css from '../styles/landing.css?raw'
---

<Page
  title="All sessions — videoskillet"
  description="Every session the app has autosaved for your account, oldest to newest, with a resume link and a delete for each."
  css={css}
  canonical={`${ORIGIN}sessions/`}
  robots="noindex"
  account={false}
>
  <main class="wrap wide sessionsPage">
    <p class="sessionsBack">
      <a href="/#recent">← Home</a>
    </p>
    <h1 class="head">All sessions</h1>
    <p class="sub">
      The app saves each visit as you work. Opening one carries on from where
      that visit stopped.
    </p>
    <div id="sessionsRoot"></div>
  </main>

  <Fragment slot="scripts">
    <script src="../scripts/sessions.ts"></script>
  </Fragment>
</Page>
