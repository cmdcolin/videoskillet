---
import Analytics from '../components/Analytics.astro'
import Footer from '../components/Footer.astro'
import SiteBar from '../components/SiteBar.astro'
import css from '../styles/landing.css?raw'
import designTokens from '../../src/tokens.css?raw'
import site from '../styles/site.css?raw'
import footer from '../styles/footer.css?raw'
import tokens from '../styles/tokens.css?raw'

const SITE = 'https://videoskillet.com/'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>All sessions — videoskillet.js</title>
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="Every session the app has autosaved for your account, oldest to newest, with a resume link and a delete for each."
    />
    <link rel="canonical" href={`${SITE}sessions/`} />
    <meta name="theme-color" content="#0e0e11" />
    <meta name="color-scheme" content="dark" />
    <style
      is:inline
      set:html={designTokens + tokens + site + footer + css}
    ></style>
    <Analytics />
  </head>
  <body id="top">
    <SiteBar account={false} />

    <main class="wrap wide sessionsPage">
      <p class="sessionsBack">
        <a href="/#recent">← Home</a>
      </p>
      <h1 class="head">All sessions</h1>
      <p class="sub">
        The app saves each visit as you work. Opening one carries on from where
        that visit stopped.
      </p>
      <div id="sessionsRoot"></div>
    </main>

    <Footer />
    <script src="../scripts/sessions.ts"></script>
  </body>
</html>
