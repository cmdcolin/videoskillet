---
import Carousel from '../components/Carousel.astro'
import Gallery from '../components/Gallery.astro'
import Hero from '../components/Hero.astro'
import HomeSkeleton from '../components/HomeSkeleton.astro'
import SignedInHint from '../components/SignedInHint.astro'
import SocialMeta from '../components/SocialMeta.astro'
import WhySignInCard from '../components/WhySignInCard.astro'
import Page from '../layouts/Page.astro'
import { ORIGIN } from '../lib/site'
import script from '../scripts/landing.js?raw'
import css from '../styles/landing.css?raw'

const TITLE = 'videoskillet.js — WebGPU analog video emulation'
const DESCRIPTION =
  'Real-time NTSC / VHS / composite-video glitch simulator in WebGPU — dot crawl, dropouts, head-switch wobble and video feedback emerge from a simulated analog signal, not filters painted on top.'
const UNFURL =
  'Analog video glitches — dot crawl, dropouts, head-switch wobble, video feedback — that fall out of a simulated NTSC signal path, live in the browser.'

const SHARE_IMAGE = `${ORIGIN}og.jpg`
const SHARE_IMAGE_W = 1200
const SHARE_IMAGE_H = 630
---

<Page title={TITLE} description={DESCRIPTION} css={css} canonical={ORIGIN}>
  <Fragment slot="meta">
    <SocialMeta
      siteName="videoskillet.js"
      url={ORIGIN}
      title={TITLE}
      description={UNFURL}
      image={SHARE_IMAGE}
      imageWidth={SHARE_IMAGE_W}
      imageHeight={SHARE_IMAGE_H}
    />
  </Fragment>

  <Fragment slot="head">
    <SignedInHint />
  </Fragment>

  <!-- The signed-in home, filled by site/scripts/home.ts once Firebase has
       said who is here. Empty in the HTML every stranger gets. -->
  <div id="home" class="home" hidden></div>

  <HomeSkeleton />

  <div id="landing">
    <section class="hero">
      <Hero />
      <div class="wrap heroBody">
        <p class="heroCta">
          <a class="btn primary" href="/app/">
            Open the app →
          </a>
          <a class="btn" href="/guide/">
            User guide
          </a>
        </p>

        <p class="req gpuwarn" hidden>
          Unfortunately, this browser has no WebGPU. You'll just get an error if
          you try to open the app. Please try another browser or use Chrome
          Canary or Firefox Nightly or look up how to enable WebGPU in your
          browser!
        </p>
      </div>
    </section>

    <!-- The app being used, which is the one thing about this program a
         stranger cannot work out from a picture of what it makes. Four
         recordings of the window: one button handing you looks you did not
         build, presets stacked into combinations, the map the controls hang
         off, and a look built by hand from nothing. In that order, for the
         reason `scripts/reel.mjs` gives — the stage and the tabs both come
         from there. -->
    <section>
      <div class="wrap wide">
        <Carousel />
      </div>
    </section>

    <section id="gallery">
      <div class="wrap wide">
        <h2 class="head">Gallery</h2>
        <p class="sub">Open one and you land on that exact board.</p>
        <div id="galleryHost">
          <Gallery />
        </div>
      </div>
    </section>

    <!-- Where the controls are, which is the question a stranger arrives at
         after the demos: the map at the head of the sidebar, boxed in the
         window and enlarged beside it. The figure is the README's, served
         from docs/img by the `figures` integration in astro.config.mjs. -->
    <section>
      <div class="wrap wide">
        <h2 class="head">How do I use this thing?</h2>
        <p class="sub">Use the signal path!</p>
        <figure>
          <img
            src="/guide/img/signal-path-callout.jpg"
            alt="The app window with the signal path map boxed in red at the head of the sidebar and enlarged over the picture: SOURCE A and SOURCE B into MIX, then CHANNEL, RECEIVER and SCREEN, with camera and mixer returns arching back over the trunk, SOUND and VIEW hanging below, and MODULATION and DECK on a row of their own with no wire reaching them"
            width="1800"
            height="1227"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            It sits at the top of the sidebar. Load videos into SOURCE A and
            SOURCE B; click any other stage to open its controls.
          </figcaption>
        </figure>
      </div>
    </section>
  </div>

  <WhySignInCard />

  <Fragment slot="scripts">
    <script is:inline set:html={script}></script>
    <!-- Bundled rather than inlined like the three above it, so its firebase
         imports stay dynamic chunks the page only fetches when somebody signs
         in (src/ui/cloud.ts). -->
    <script src="../scripts/home.ts"></script>
  </Fragment>
</Page>
