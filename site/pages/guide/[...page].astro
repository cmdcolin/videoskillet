---
import GuideDoc from '../../components/GuideDoc.astro'
import { ALL } from '../../lib/pages.mjs'

export function getStaticPaths() {
  return ALL.filter(spec => spec.out !== 'index.html').map(spec => ({
    params: { page: spec.slug },
    props: { spec },
  }))
}

const { spec } = Astro.props
---

<GuideDoc spec={spec} />
