---
// CROSS_REPO_SYNC_FILE(social-meta)
//
// How a link to this page unfurls when somebody shares it. The values differ
// per product and per page; the tags do not, so the whole file is shared.
//
// The description here is the one a reader meets in a chat window rather than
// in a search result, so a page may hand in a shorter one than it gives
// `<meta name="description">`.
interface Props {
  siteName: string
  url: string
  title: string
  description: string
  image: string
  imageWidth: number
  imageHeight: number
}
const { siteName, url, title, description, image, imageWidth, imageHeight } =
  Astro.props
---

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={imageWidth} />
<meta property="og:image:height" content={imageHeight} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
