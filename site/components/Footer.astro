---
// One footer for the whole site, so every page ends the same way wherever a
// reader lands.
import { SITE } from '../lib/site'
---

<!-- CROSS_REPO_SYNC(site-footer-markup) -->
<footer class="siteFoot">
  <div class="footIn">
    <nav aria-label="Site">
      {SITE.footer.map(([href, label]) => (
        <a href={href}>{label}</a>
      ))}
      <a href="#top">Back to top ↑</a>
    </nav>
  </div>
</footer>
<!-- CROSS_REPO_SYNC_END(site-footer-markup) -->
