---
// The guide's bar, lifted out of the layout so its markup and the props it
// needs sit in one file: `label` is what follows the name — the group the
// reader is in — and `links` is the row under it, one entry per page, `on`
// marking the one being read. The rules are guide.css.
//
// The landing page carries a bar of its own, SiteBar.astro. A bar over the hero
// was tried and turned down once; the account reversed that, because a page that
// can be signed in needs somewhere to say who is signed in. The two stay
// separate components: the middle of this one is the pages of one guide group,
// and the middle of SiteBar is the site.
interface Props {
  label?: string
  links: { href: string; nav: string; on?: boolean }[]
}

const { label, links } = Astro.props
---

<header>
  <div class="bar">
    <a class="brand" href="/">
      videoskillet{label === undefined ? null : <span>{label}</span>}
    </a>
    <nav class="pages" aria-label="Site pages">
      {links.map(link => (
        <a
          class={link.on === true ? 'on' : undefined}
          aria-current={link.on === true ? 'page' : undefined}
          href={link.href}
        >
          {link.nav}
        </a>
      ))}
    </nav>
    <a class="cta" href="/app/">
      Open the app ↗
    </a>
  </div>
</header>
