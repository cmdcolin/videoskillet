---
// The guide's bar, lifted out of the layout so its markup and the props it
// needs sit in one file: `label` is what follows the name — the group the
// reader is in — and `links` is the row under it, one entry per page, `on`
// marking the one being read. The rules are guide.css.
//
// The landing page does not carry this. It opens on a picture, and a bar across
// the top of that was tried and turned down.
interface Props {
  label?: string
  links: { href: string; nav: string; on?: boolean }[]
}

const { label, links } = Astro.props
---

<header>
  <div class="bar">
    <a class="brand" href="/">
      videoskillet.js{label === undefined ? null : <span>{label}</span>}
    </a>
    <nav class="pages" aria-label="Site pages">
      {links.map(link => (
        <a
          class={link.on === true ? 'on' : undefined}
          aria-current={link.on === true ? 'page' : undefined}
          href={link.href}
        >
          {link.nav}
        </a>
      ))}
    </nav>
    <a class="cta" href="/app/">
      Open the app ↗
    </a>
  </div>
</header>
