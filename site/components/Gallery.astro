---
// One card per demo `demos.json` marks for the gallery. The still is an <img>
// under the clip rather than the <video>'s own `poster`, so that it can carry
// `loading="lazy"` — a poster is fetched the moment its <video> is laid out,
// and twelve of those were most of a megabyte nobody had scrolled to yet.
//
// `alt=""` because the name is on the card beside it.
//
// A demo's posts are plain links under its card, so a reader can learn how the
// mechanism on screen works.
import { gallery } from '../../scripts/demos.mjs'
---

<ul class="grid">
  {gallery.map(demo => (
    <li>
      <a class="demo" href={demo.href} data-cam={demo.cam}>
        <span class="shot">
          <img
            class="still"
            src={demo.poster}
            alt=""
            width="640"
            height="512"
            loading="lazy"
            decoding="async"
          />
          <video
            data-src={demo.clip}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
          />
        </span>
        <span class="name">
          {demo.name}
          <span class="open">open →</span>
        </span>
      </a>
      {demo.posts.length > 0 && (
        <p class="posts">
          read:{' '}
          {demo.posts.map((post, i) => (
            <>
              {i > 0 && ' · '}
              <a href={post.href} title={post.title} set:text={post.label} />
            </>
          ))}
        </p>
      )}
    </li>
  ))}
</ul>
