---
// The bar across the top of every site page. On `/` it also carries the
// account: the sign-in button is server-rendered, because the page is static
// HTML and nobody is signed in until the home script has asked, and the script
// swaps it for the avatar once Firebase answers.
//
// `account={false}` leaves that half out, for a page that does not load the
// home script: those controls are inert without it, and an inert sign-in
// button is worse than none. `current` marks the nav link for the page it is on.
import { SITE } from '../lib/site'

interface Props {
  account?: boolean
  current?: string
}
const { account = true, current } = Astro.props
---

<!-- CROSS_REPO_SYNC(site-bar-markup) -->

<header class="siteBar">
  <div class="barIn">
    <a class="barBrand" href={SITE.home}>
      <img src={SITE.icon} width="24" height="24" alt="" />
      <span>{SITE.name}</span>
    </a>
    <nav class="barNav" aria-label="Site">
      {SITE.nav.map(([href, label]) => (
        <a href={href} aria-current={href === current ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <div class="barEnd">
      {account && (
        <Fragment>
          {/* The question beside the ask, where the reader meets it. */}
          <button class="why" id="why" type="button">
            Why sign in?
          </button>
          <button
            class="btn slim"
            id="signIn"
            type="button"
            aria-label="Sign in"
          >
            <svg
              class="ico"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="8" r="3.6" />
              <path d="M4.8 20a7.2 7.2 0 0 1 14.4 0" />
            </svg>
            <span class="barLabel">Sign in</span>
          </button>
          <div class="acct" id="acct" hidden>
            <button
              class="acctBtn"
              id="acctBtn"
              type="button"
              aria-haspopup="menu"
              aria-expanded="false"
            >
              <span class="avatar" id="avatar" />
            </button>
            <div class="acctMenu" id="acctMenu" role="menu" hidden>
              <p class="acctName" id="acctName" />
              <button
                class="acctOut"
                id="signOut"
                type="button"
                role="menuitem"
              >
                Sign out
              </button>
            </div>
          </div>
        </Fragment>
      )}
      <a class="btn primary slim" href={SITE.app}>
        Open the app →
      </a>
    </div>
  </div>
</header>
<!-- CROSS_REPO_SYNC_END(site-bar-markup) -->
