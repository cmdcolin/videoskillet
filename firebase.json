{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "*.test.js", "firebase-debug.log"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "videoskillet & bender",
        "supportEmail": "colin.diesh@gmail.com"
      }
    }
  },
  "extensions": {
    "delete-user-data": "firebase/delete-user-data@0.1.30"
  },
  "emulators": {
    "firestore": {
      "port": 8817
    },
    "ui": {
      "enabled": false
    }
  }
}
