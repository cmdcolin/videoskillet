index 0000000..5780890
--- /dev/null
+++ b/scripts/spike-take.mjs
@@ -0,0 +1,269 @@
+// Spike: a real take of the sync clip through the app's own record toggle.
+//   node scripts/spike-take.mjs [--port=5311] [--secs=20] [--size=1920x1080]
+//     [--clock=smooth|latency|envelope|output|process] [--q=4] [--pool=3]
+//     [--hitch=0] [--hitchEvery=2000] [--silent] [--browser=firefox|chrome]
+//     [--out=take.mp4]
+// --silent records with the video's sound off, which is today's rAF path.
+// Pipe the output through scripts/spike-sum.py for one line per take.
+import puppeteer from 'puppeteer-core'
+
+import { CHROME, FIREFOX } from './browser.mjs'
+import { appUp } from './until.mjs'
+
+import { execFileSync } from 'node:child_process'
+import { createWriteStream } from 'node:fs'
+import { createServer } from 'node:http'
+import process from 'node:process'
+
+const arg = (k, d) => {
+  const hit = process.argv.find(a => a.startsWith(`--${k}=`))
+  return hit === undefined ? d : hit.slice(k.length + 3)
+}
+const flag = k => process.argv.includes(`--${k}`)
+const port = arg('port', '5311')
+const secs = Number(arg('secs', '20'))
+const [vw, vh] = arg('size', '1920x1080').split('x').map(Number)
+const clock = arg('clock', 'output')
+const hitch = Number(arg('hitch', '0'))
+const hitchEvery = Number(arg('hitchEvery', '2000'))
+const silent = flag('silent')
+const outFile = arg('out', `${process.env.TMPDIR ?? '/tmp'}/take.mp4`)
+
+let landed
+const got = new Promise(r => (landed = r))
+const server = createServer((req, res) => {
+  res.setHeader('Access-Control-Allow-Origin', '*')
+  res.setHeader('Access-Control-Allow-Headers', '*')
+  if (req.method === 'OPTIONS') return res.end()
+  const w = createWriteStream(outFile)
+  req.pipe(w)
+  w.on('finish', () => {
+    res.end('ok')
+    landed()
+  })
+}).listen(5399)
+
+// Chrome is untested: this box's Chrome has no WebGPU.
+const chrome = arg('browser', 'firefox') === 'chrome'
+const browser = await puppeteer.launch(
+  chrome
+    ? {
+        browser: 'chrome',
+        executablePath: CHROME,
+        headless: false,
+        defaultViewport: null,
+        protocolTimeout: 900000,
+        args: [
+          `--window-size=${vw},${vh}`,
+          '--enable-unsafe-webgpu',
+          '--autoplay-policy=no-user-gesture-required',
+        ],
+      }
+    : {
+        browser: 'firefox',
+        executablePath: FIREFOX,
+        headless: false,
+        defaultViewport: null,
+        protocolTimeout: 900000,
+        args: [`--width=${vw}`, `--height=${vh}`],
+        extraPrefsFirefox: {
+          'dom.webgpu.enabled': true,
+          'gfx.webgpu.ignore-blocklist': true,
+          'media.autoplay.default': 0,
+          'media.autoplay.blocking_policy': 0,
+        },
+      },
+)
+try {
+  const page = (await browser.pages())[0] ?? (await browser.newPage())
+  page.on('pageerror', e => console.log('pageerror', String(e).slice(0, 200)))
+  page.on('console', m => {
+    if (m.type() === 'error' || m.text().startsWith('SPIKE'))
+      console.log(m.type(), m.text().slice(0, 200))
+  })
+  await page.goto(
+    `http://localhost:${port}/app/?vurl=/spike/sync.mp4&rectake=1&recclock=${clock}&gpubudget=ignore&recpool=${arg('pool', '3')}&recq=${arg('q', '2')}`,
+    { waitUntil: 'domcontentloaded' },
+  )
+  if (!(await appUp(page, 20000))) throw new Error('app did not come up')
+  await page.bringToFront()
+  await new Promise(r => setTimeout(r, 4000))
+  if (!silent) {
+    await page.evaluate(() => window.__audio.select('video'))
+    await new Promise(r => setTimeout(r, 1500))
+  }
+  const res = await page.evaluate(
+    async (secs, hitch, hitchEvery) => {
+      const raf = () => new Promise(r => requestAnimationFrame(r))
+      const ctx = window.vf.audioState.graph?.ctx
+      const rate = async ms => {
+        const f0 = window.vf.frameNo()
+        const t0 = performance.now()
+        let ticks = 0
+        let worst = 0
+        let prev = t0
+        while (performance.now() - t0 < ms) {
+          await raf()
+          const now = performance.now()
+          worst = Math.max(worst, now - prev)
+          prev = now
+          ticks++
+        }
+        const dt = (performance.now() - t0) / 1000
+        return {
+          rafHz: +(ticks / dt).toFixed(1),
+          engineHz: +((window.vf.frameNo() - f0) / dt).toFixed(1),
+          worstGapMs: +worst.toFixed(1),
+        }
+      }
+      const out = {
+        ctx: ctx
+          ? {
+              state: ctx.state,
+              rate: ctx.sampleRate,
+              baseLatency: ctx.baseLatency,
+              outputLatency: ctx.outputLatency,
+            }
+          : null,
+        canvas: `${document.querySelector('canvas').width}x${document.querySelector('canvas').height}`,
+      }
+      out.before = await rate(3000)
+      window.__capture.toggleRecord()
+      const until = async (f, ms) => {
+        const t = performance.now()
+        while (!f() && performance.now() - t < ms)
+          await new Promise(r => setTimeout(r, 20))
+        return f()
+      }
+      await until(() => window.__capture.recording || window.__rec, 5000)
+      const hitches = []
+      const timer =
+        hitch > 0
+          ? setInterval(() => {
+              const t = performance.now()
+              while (performance.now() - t < hitch);
+              hitches.push(t)
+            }, hitchEvery)
+          : 0
+      const probe = []
+      const probeTimer = setInterval(() => {
+        const c = window.vf.audioState.graph?.ctx
+        if (!c) return
+        const p = performance.now()
+        const o = c.getOutputTimestamp()
+        probe.push([p, c.currentTime, o.contextTime, o.performanceTime])
+      }, 1)
