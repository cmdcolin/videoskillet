+        // that falls between updates if it is stale.
+        const d = probe.map(([p, ct]) => ct * 1000 - p)
+        const top = Math.max(...d.slice(0, 200))
+        const lag = d.map(v => top - v)
+        lag.sort((a, b) => a - b)
+        const q = f => +lag[Math.floor(lag.length * f)].toFixed(1)
+        let updates = 0
+        for (let i = 1; i < probe.length; i++) if (probe[i][1] !== probe[i - 1][1]) updates++
+        const span = (probe.at(-1)[0] - probe[0][0]) / 1000
+        const dOut = probe.map(([p, , oc, op]) => oc * 1000 - op)
+        const firstHalf = d.slice(0, d.length >> 1), secondHalf = d.slice(d.length >> 1)
+        out.clockProbe = {
+          samples: probe.length,
+          currentTimeUpdatesPerSec: +(updates / span).toFixed(1),
+          staleMs: { p50: q(0.5), p90: q(0.9), p99: q(0.99), max: q(0.999) },
+          envelopeDriftMs: +(Math.max(...secondHalf) - Math.max(...firstHalf)).toFixed(2),
+          outputMinusPerfSpreadMs: +(Math.max(...dOut) - Math.min(...dOut)).toFixed(1),
+          outputVsCurrentMs: +((probe.at(-1)[2] - probe.at(-1)[1]) * 1000).toFixed(1),
+        }
+      }
+      const fr = window.vf.frameRead
+      out.pool = fr ? { copied: fr.copied, skipped: fr.skipped } : null
+      clearInterval(timer)
+      out.hitches = hitches.length
+      const t0 = performance.now()
+      window.__capture.toggleRecord()
+      await until(() => window.__take !== undefined, 120000)
+      out.stopToFileMs = Math.round(performance.now() - t0)
+      if (window.__take === undefined) {
+        const r = window.__rec
+        return {
+          ...out,
+          failed: true,
+          recFrames: r?.frames(),
+          recError: r?.error(),
+          stats: r?.stats?.().length,
+          recording: window.__capture.recording,
+          heard: window.vf.audioState.heard() !== null,
+          ctxState: window.vf.audioState.graph?.ctx.state,
+          banner: [...document.querySelectorAll('[role=alert],[class*=rror]')]
+            .map(e => e.textContent)
+            .join(' | ')
+            .slice(0, 400),
+        }
+      }
+      out.mb = +(window.__take.size / 1e6).toFixed(2)
+      const stats = window.__rec?.stats?.() ?? []
+      if (stats.length > 0) {
+        const pct = (xs, p) => {
+          const s = [...xs].sort((a, b) => a - b)
+          return +s[Math.min(s.length - 1, Math.floor(s.length * p))].toFixed(2)
+        }
+        const kept = stats.filter(s => s.kept)
+        const lat = stats.map(s => s.arrivedAt - s.renderedAt)
+        const lead = stats.map(s => (s.proc - s.out) * 1000)
+        const gaps = new Map()
+        for (let i = 1; i < kept.length; i++) {
+          const g = kept[i].slot - kept[i - 1].slot
+          gaps.set(g, (gaps.get(g) ?? 0) + 1)
+        }
+        out.frames = {
+          arrived: stats.length,
+          kept: kept.length,
+          droppedSameSlot: stats.filter(s => s.why === 'slot').length,
+          droppedQueue: stats.filter(s => s.why === 'queue').length,
+          maxQueue: Math.max(...stats.map(s => s.queue)),
+          arriveLatencyMs: { p50: pct(lat, 0.5), p90: pct(lat, 0.9), max: pct(lat, 1) },
+          procLeadsOutMs: { p50: pct(lead, 0.5), min: pct(lead, 0), max: pct(lead, 1) },
+          slotGaps: Object.fromEntries([...gaps.entries()].sort((a, b) => a[0] - b[0])),
+          lastSlot: kept.at(-1)?.slot,
+          // Where each kept frame landed against where its render time alone
+          // would put it, after removing the mean: the clock's own noise.
+          slotNoise: (() => {
+            const r0 = kept[0]?.renderedAt ?? 0
+            const res = kept.map(s => s.slot - ((s.renderedAt - r0) * 60) / 1000)
+            const m = res.reduce((a, b) => a + b, 0) / (res.length || 1)
+            const dev = res.map(v => Math.abs(v - m)).sort((a, b) => a - b)
+            return {
+              p50: +dev[dev.length >> 1].toFixed(2),
+              p90: +dev[Math.floor(dev.length * 0.9)].toFixed(2),
+              max: +dev.at(-1).toFixed(2),
+            }
+          })(),
+        }
+      }
+      await fetch('http://localhost:5399/take', {
+        method: 'POST',
+        body: window.__take,
+      })
+      return out
+    },
+    secs,
+    hitch,
+    hitchEvery,
+  )
+  console.log(JSON.stringify(res))
+  if (res.failed) process.exit(1)
+  await got
+  console.log(
+    execFileSync('node', [
+      new URL('./spike-avsync.mjs', import.meta.url).pathname,
+      outFile,
+    ])
+      .toString()
+      .replace(/\s+/g, ' '),
+  )
+} finally {
+  await browser.close()
+  server.close()
+}
