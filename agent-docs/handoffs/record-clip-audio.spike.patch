diff --git a/scripts/spike-avsync.mjs b/scripts/spike-avsync.mjs
new file mode 100644
index 0000000..57fbaa8
--- /dev/null
+++ b/scripts/spike-avsync.mjs
@@ -0,0 +1,113 @@
+// Spike: find the sync clip's flashes and clicks in a take and report the
+// offset between them.
+//   node scripts/spike-avsync.mjs take.mp4
+import { execFileSync } from 'node:child_process'
+
+const file = process.argv[2]
+const probe = execFileSync('ffprobe', [
+  '-v', 'error', '-show_entries',
+  'stream=codec_type,codec_name,sample_rate,channels,duration,nb_frames,r_frame_rate,avg_frame_rate:stream_tags=:format=duration',
+  '-of', 'json', file,
+]).toString()
+const info = JSON.parse(probe)
+const ptsRaw = execFileSync('ffprobe', [
+  '-v', 'error', '-select_streams', 'v:0', '-show_entries', 'frame=pts_time', '-of', 'csv=p=0', file,
+], { maxBuffer: 1 << 28 }).toString().trim().split('\n').map(Number)
+
+const W = 16, H = 12
+const raw = execFileSync('ffmpeg', [
+  '-v', 'error', '-i', file, '-map', '0:v:0', '-vsync', 'passthrough',
+  '-vf', `scale=${W}:${H},format=gray`, '-f', 'rawvideo', '-',
+], { maxBuffer: 1 << 30 })
+const n = Math.floor(raw.length / (W * H))
+const means = []
+for (let i = 0; i < n; i++) {
+  let s = 0
+  for (let j = 0; j < W * H; j++) s += raw[i * W * H + j]
+  means.push(s / (W * H))
+}
+const sorted = [...means].sort((a, b) => a - b)
+const lo = sorted[Math.floor(n * 0.1)], hi = sorted[Math.floor(n * 0.995)]
+const thr = lo + (hi - lo) * 0.5
+// Presentation order: ffprobe lists decoded frames in output order already.
+const flashes = []
+const darkBefore = []
+for (let i = 1; i < n; i++)
+  if (means[i] > thr && means[i - 1] <= thr) {
+    flashes.push(ptsRaw[i])
+    darkBefore.push(ptsRaw[i - 1])
+  }
+
+const hasAudio = info.streams.some(s => s.codec_type === 'audio')
+let clicks = []
+if (hasAudio) {
+  const RATE = 48000
+  const pcm = execFileSync('ffmpeg', [
+    '-v', 'error', '-i', file, '-map', '0:a:0', '-ac', '1', '-ar', String(RATE), '-f', 'f32le', '-',
+  ], { maxBuffer: 1 << 30 })
+  const a = new Float32Array(pcm.buffer, pcm.byteOffset, pcm.length / 4)
+  let peak = 0
+  for (const v of a) peak = Math.max(peak, Math.abs(v))
+  const at = peak * 0.3
+  let quietUntil = 0
+  for (let i = 0; i < a.length; i++) {
+    if (Math.abs(a[i]) > at && i >= quietUntil) {
+      clicks.push(i / RATE)
+      quietUntil = i + RATE * 0.3
+    }
+  }
+}
+
+const pairs = []
+const bounds = []
+for (const c of clicks) {
+  let bi = -1
+  for (let i = 0; i < flashes.length; i++)
+    if (bi < 0 || Math.abs(flashes[i] - c) < Math.abs(flashes[bi] - c)) bi = i
+  if (bi >= 0 && Math.abs(flashes[bi] - c) < 0.45) {
+    pairs.push({ t: flashes[bi], off: (c - flashes[bi]) * 1000 })
+    // The onset lies in (darkBefore, flash], so the offset lies in
+    // [c - flash, c - darkBefore).
+    bounds.push({ t: c, lo: (c - flashes[bi]) * 1000, hi: (c - darkBefore[bi]) * 1000 })
+  }
+}
+const half = arr => arr.slice(0, Math.max(1, arr.length >> 1))
+const meet = bs => ({
+  lo: +Math.max(...bs.map(b => b.lo)).toFixed(1),
+  hi: +Math.min(...bs.map(b => b.hi)).toFixed(1),
+})
+const offs = pairs.map(p => p.off)
+const mean = offs.reduce((s, v) => s + v, 0) / (offs.length || 1)
+let slope = 0
+if (pairs.length > 2) {
+  const mt = pairs.reduce((s, p) => s + p.t, 0) / pairs.length
+  let num = 0, den = 0
+  for (const p of pairs) { num += (p.t - mt) * (p.off - mean); den += (p.t - mt) ** 2 }
+  slope = num / den
+}
+const gaps = new Map()
+for (let i = 1; i < ptsRaw.length; i++) {
+  const g = Math.round((ptsRaw[i] - ptsRaw[i - 1]) * 1e5) / 1e2
+  gaps.set(g, (gaps.get(g) ?? 0) + 1)
+}
+console.log(JSON.stringify({
+  streams: info.streams.map(s => `${s.codec_type}:${s.codec_name}${s.sample_rate ? '@' + s.sample_rate + 'x' + s.channels : ''} dur=${s.duration} n=${s.nb_frames ?? ''} r=${s.r_frame_rate} avg=${s.avg_frame_rate}`),
+  frames: n, flashes: flashes.length, clicks: clicks.length, pairs: pairs.length,
+  offsetMs: { mean: +mean.toFixed(2), min: +Math.min(...offs).toFixed(2), max: +Math.max(...offs).toFixed(2), first: offs.slice(0, 3).map(v => +v.toFixed(1)), last: offs.slice(-3).map(v => +v.toFixed(1)) },
+  driftMsPerMin: +(slope * 60).toFixed(2),
+  mid: (() => {
+    const m = bounds.map(b => (b.lo + b.hi) / 2).sort((a, b) => a - b)
+    const q = f => +m[Math.min(m.length - 1, Math.floor(m.length * f))].toFixed(1)
+    return m.length ? { p10: q(0.1), p50: q(0.5), p90: q(0.9) } : null
+  })(),
+  midFirstVsLast: (() => {
+    const m = bounds.map(b => (b.lo + b.hi) / 2)
+    const k = Math.max(1, Math.floor(m.length / 4))
+    const med = a => [...a].sort((x, y) => x - y)[a.length >> 1]
+    return m.length ? [+med(m.slice(0, k)).toFixed(1), +med(m.slice(-k)).toFixed(1)] : null
+  })(),
+  bound: bounds.length ? meet(bounds) : null,
+  boundFirstHalf: bounds.length ? meet(half(bounds)) : null,
+  boundSecondHalf: bounds.length ? meet(bounds.slice(bounds.length >> 1)) : null,
+  frameGapsMs: Object.fromEntries([...gaps.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6)),
+}))
diff --git a/scripts/spike-encoder.mjs b/scripts/spike-encoder.mjs
new file mode 100644
index 0000000..969ee3c
--- /dev/null
+++ b/scripts/spike-encoder.mjs
@@ -0,0 +1,110 @@
+// Spike: raw H.264 encoder throughput in Firefox, per latencyMode and size,
+// and whether its output reorders frames (B-frames).
+//   node scripts/spike-encoder.mjs [port]
+import puppeteer from 'puppeteer-core'
+
+import { FIREFOX } from './browser.mjs'
+import { appUp } from './until.mjs'
+
+import process from 'node:process'
+
+const port = process.argv[2] ?? '5311'
+const browser = await puppeteer.launch({
+  browser: 'firefox',
+  executablePath: FIREFOX,
+  headless: false,
+  defaultViewport: null,
+  args: ['--width=1920', '--height=1080'],
+  extraPrefsFirefox: {
+    'dom.webgpu.enabled': true,
+    'gfx.webgpu.ignore-blocklist': true,
+  },
+})
+try {
+  const page = (await browser.pages())[0] ?? (await browser.newPage())
+  await page.goto(`http://localhost:${port}/app/?gpubudget=ignore`, {
+    waitUntil: 'domcontentloaded',
+  })
+  await appUp(page, 20000)
+  await page.bringToFront()
+  await new Promise(r => setTimeout(r, 3000))
+  const out = await page.evaluate(async () => {
+    const cv = document.querySelector('canvas')
+    const { candidatesFor } = await import('/src/ui/record.ts')
+    // A handful of real frames, so the encoder sees the app's noise.
+    const src = []
+    for (let i = 0; i < 8; i++) {
+      await new Promise(r => requestAnimationFrame(r))
+      src.push(new VideoFrame(cv, { timestamp: 0 }))
+    }
+    const sizes = [
+      [cv.width - (cv.width % 2), cv.height - (cv.height % 2)],
+      [754, 480],
+      [1280, 720],
+    ]
+    const res = []
+    for (const [w, h] of sizes) {
+      for (const mode of ['quality', 'realtime']) {
+        const bitrate = Math.min(60e6, Math.max(16e6, w * h * 60 * 0.4))
+        let codec = ''
+        for (const c of candidatesFor(w, h)) {
+          const cfg = { codec: c, width: w, height: h, bitrate, framerate: 60, avc: { format: 'avc' }, latencyMode: mode }
+          if ((await VideoEncoder.isConfigSupported(cfg)).supported) {
+            codec = c
+            break
+          }
+        }
+        const ts = []
+        let bytes = 0
+        const enc = new VideoEncoder({
+          output: c => {
+            ts.push(c.timestamp)
+            bytes += c.byteLength
+          },
+          error: e => console.log('enc error', String(e)),
+        })
+        enc.configure({ codec, width: w, height: h, bitrate, framerate: 60, avc: { format: 'avc' }, latencyMode: mode })
+        const N = 180
+        const t0 = performance.now()
+        let maxQ = 0
+        const encodeMs = []
+        for (let i = 0; i < N; i++) {
+          const f = new VideoFrame(src[i % src.length], {
+            timestamp: Math.round((i * 1e6) / 60),
+            visibleRect: { x: 0, y: 0, width: w, height: h },
+          })
+          const a = performance.now()
+          enc.encode(f, { keyFrame: i % 120 === 0 })
+          encodeMs.push(performance.now() - a)
+          f.close()
+          maxQ = Math.max(maxQ, enc.encodeQueueSize)
+          // Paced like a 60 Hz producer that yields.
+          while (enc.encodeQueueSize > 8) await new Promise(r => setTimeout(r, 1))
+          if (i % 4 === 0) await new Promise(r => setTimeout(r, 0))
+        }
+        await enc.flush()
+        const dt = (performance.now() - t0) / 1000
+        enc.close()
+        let reordered = 0
+        for (let i = 1; i < ts.length; i++) if (ts[i] < ts[i - 1]) reordered++
+        encodeMs.sort((a, b) => a - b)
+        res.push({
+          size: `${w}x${h}`,
+          mode,
+          codec,
+          fps: +(N / dt).toFixed(1),
+          reordered,
+          maxQ,
+          encodeCallP50: encodeMs[N >> 1],
+          encodeCallMax: encodeMs[N - 1],
+          mbps: +((bytes * 8) / (N / 60) / 1e6).toFixed(1),
+        })
+      }
+    }
+    for (const f of src) f.close()
+    return res
+  })
+  for (const r of out) console.log(JSON.stringify(r))
+} finally {
+  await browser.close()
+}
diff --git a/scripts/spike-readback.mjs b/scripts/spike-readback.mjs
new file mode 100644
index 0000000..a1b88e0
--- /dev/null
+++ b/scripts/spike-readback.mjs
@@ -0,0 +1,157 @@
+// Spike: is `new VideoFrame(webgpuCanvas)` a GPU stall or a copy, and what does
+// an async copyTextureToBuffer readback cost the main thread instead?
+//   node scripts/spike-readback.mjs [port] [WxH]
+import puppeteer from 'puppeteer-core'
+
+import { FIREFOX } from './browser.mjs'
+import { appUp } from './until.mjs'
+
+import process from 'node:process'
+
+const port = process.argv[2] ?? '5311'
+const [vw, vh] = (process.argv[3] ?? '800x600').split('x').map(Number)
+const browser = await puppeteer.launch({
+  browser: 'firefox',
+  executablePath: FIREFOX,
+  headless: false,
+  defaultViewport: null,
+  args: [`--width=${vw}`, `--height=${vh}`],
+  extraPrefsFirefox: {
+    'dom.webgpu.enabled': true,
+    'gfx.webgpu.ignore-blocklist': true,
+    'media.autoplay.default': 0,
+    'media.autoplay.blocking_policy': 0,
+  },
+})
+const page = (await browser.pages())[0] ?? (await browser.newPage())
+page.on('pageerror', e => console.log('pageerror', String(e).slice(0, 200)))
+await page.goto(
+  `http://localhost:${port}/app/?vurl=/spike/sync.mp4&gpubudget=ignore`,
+  { waitUntil: 'domcontentloaded' },
+)
+console.log('up', await appUp(page, 15000))
+await page.bringToFront()
+await new Promise(r => setTimeout(r, 3000))
+
+const out = await page.evaluate(async () => {
+  const vf = window.vf
+  const cv = document.querySelector('canvas')
+  const device = vf.gpu.device
+  const pct = (xs, p) => {
+    const s = [...xs].sort((a, b) => a - b)
+    return +s[Math.min(s.length - 1, Math.floor(s.length * p))].toFixed(2)
+  }
+  const stats = xs => ({ p50: pct(xs, 0.5), p90: pct(xs, 0.9), max: pct(xs, 1) })
+  const res = {
+    canvas: `${cv.width}x${cv.height}`,
+    format: navigator.gpu.getPreferredCanvasFormat(),
+  }
+  vf.loop.stop()
+  const N = 60
+  const gpu = [],
+    busy = [],
+    idle = [],
+    step = []
+  for (let i = 0; i < N; i++) {
+    let t = performance.now()
+    vf.step()
+    step.push(performance.now() - t)
+    t = performance.now()
+    await device.queue.onSubmittedWorkDone()
+    gpu.push(performance.now() - t)
+  }
+  for (let i = 0; i < N; i++) {
+    vf.step()
+    const t = performance.now()
+    new VideoFrame(cv, { timestamp: i }).close()
+    busy.push(performance.now() - t)
+    await new Promise(r => setTimeout(r, 0))
+  }
+  for (let i = 0; i < N; i++) {
+    vf.step()
+    await device.queue.onSubmittedWorkDone()
+    const t = performance.now()
+    new VideoFrame(cv, { timestamp: i }).close()
+    idle.push(performance.now() - t)
+    await new Promise(r => setTimeout(r, 0))
+  }
+  res.stepCpuMs = stats(step)
+  res.gpuWaitAfterStepMs = stats(gpu)
+  res.readbackRightAfterStepMs = stats(busy)
+  res.readbackGpuIdleMs = stats(idle)
+
+  // Async: reconfigure with COPY_SRC, copy the swapchain texture into a ring of
+  // mappable buffers in the same task as the render, build the VideoFrame when
+  // the map lands.
+  const ctx = cv.getContext('webgpu')
+  const format = navigator.gpu.getPreferredCanvasFormat()
+  ctx.configure({
+    device,
+    format,
+    alphaMode: 'opaque',
+    usage: GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.COPY_SRC,
+  })
+  const w = cv.width,
+    h = cv.height
+  const stride = Math.ceil((w * 4) / 256) * 256
+  const ring = Array.from({ length: 4 }, () =>
+    device.createBuffer({
+      size: stride * h,
+      usage: GPUBufferUsage.COPY_DST | GPUBufferUsage.MAP_READ,
+    }),
+  )
+  const submitMs = [],
+    landMs = [],
+    latency = [],
+    mapped = []
+  let pending = []
+  const fmt = format === 'bgra8unorm' ? 'BGRX' : 'RGBX'
+  const tight = stride === w * 4
+  let ok = 0
+  for (let i = 0; i < N; i++) {
+    vf.step()
+    const t0 = performance.now()
+    const buf = ring[i % ring.length]
+    const enc = device.createCommandEncoder()
+    enc.copyTextureToBuffer(
+      { texture: ctx.getCurrentTexture() },
+      { buffer: buf, bytesPerRow: stride, rowsPerImage: h },
+      [w, h],
+    )
+    device.queue.submit([enc.finish()])
+    const p = buf.mapAsync(GPUMapMode.READ).then(() => {
+      const a = performance.now()
+      latency.push(a - t0)
+      const range = buf.getMappedRange()
+      const frame = new VideoFrame(new Uint8Array(range), {
+        format: fmt,
+        codedWidth: w,
+        codedHeight: h,
+        timestamp: i,
+        ...(tight ? {} : { layout: [{ offset: 0, stride }] }),
+      })
+      buf.unmap()
+      frame.close()
+      landMs.push(performance.now() - a)
+      ok++
+    })
+    submitMs.push(performance.now() - t0)
+    pending.push(p)
+    if (pending.length >= ring.length - 1) {
+      await pending.shift()
+    }
+    await new Promise(r => setTimeout(r, 0))
+  }
+  await Promise.all(pending)
+  res.async = {
+    ok,
+    submitMs: stats(submitMs),
+    onLandMs: stats(landMs),
+    latencyMs: stats(latency),
+    stride,
+  }
+  vf.loop.start()
+  return res
+})
+console.log(JSON.stringify(out, null, 1))
+await browser.close()
diff --git a/scripts/spike-reccost.mjs b/scripts/spike-reccost.mjs
new file mode 100644
index 0000000..e191d39
--- /dev/null
+++ b/scripts/spike-reccost.mjs
@@ -0,0 +1,124 @@
+// Spike: what recording costs the main thread and the live frame rate today.
+//   node scripts/spike-reccost.mjs [port]
+import puppeteer from 'puppeteer-core'
+
+import { FIREFOX } from './browser.mjs'
+import { appUp } from './until.mjs'
+
+import process from 'node:process'
+
+const port = process.argv[2] ?? '5311'
+const browser = await puppeteer.launch({
+  browser: 'firefox',
+  executablePath: FIREFOX,
+  headless: false,
+  extraPrefsFirefox: {
+    'dom.webgpu.enabled': true,
+    'gfx.webgpu.ignore-blocklist': true,
+    'media.autoplay.default': 0,
+    'media.autoplay.blocking_policy': 0,
+  },
+})
+const page = await browser.newPage()
+page.on('pageerror', e => console.log('pageerror', String(e).slice(0, 200)))
+await page.goto(
+  `http://localhost:${port}/app/?vurl=/spike/sync.mp4&gpubudget=ignore`,
+  { waitUntil: 'domcontentloaded' },
+)
+console.log('up', await appUp(page, 15000))
+await page.bringToFront()
+await new Promise(r => setTimeout(r, 3000))
+
+const out = await page.evaluate(async () => {
+  const cv = document.querySelector('canvas')
+  const raf = () => new Promise(r => requestAnimationFrame(r))
+  const pct = (xs, p) => {
+    const s = [...xs].sort((a, b) => a - b)
+    return +s[Math.min(s.length - 1, Math.floor(s.length * p))].toFixed(3)
+  }
+  const stats = xs => ({
+    n: xs.length,
+    p50: pct(xs, 0.5),
+    p90: pct(xs, 0.9),
+    p99: pct(xs, 0.99),
+    max: pct(xs, 1),
+  })
+  const rate = async ms => {
+    const f0 = window.vf.frameNo()
+    const t0 = performance.now()
+    let ticks = 0
+    while (performance.now() - t0 < ms) {
+      await raf()
+      ticks++
+    }
+    const dt = (performance.now() - t0) / 1000
+    return {
+      rafHz: +(ticks / dt).toFixed(1),
+      engineHz: +((window.vf.frameNo() - f0) / dt).toFixed(1),
+    }
+  }
+  const res = { canvas: `${cv.width}x${cv.height}`, dpr: devicePixelRatio }
+  res.idle = await rate(3000)
+
+  const mod = await import('/src/ui/record.ts')
+  const run = async (label, fn) => {
+    const rec = await mod.startRecording({
+      width: cv.width,
+      height: cv.height,
+      fps: { num: 60, den: 1 },
+    })
+    const f0 = window.vf.frameNo()
+    const t0 = performance.now()
+    const costs = []
+    let ticks = 0
+    while (performance.now() - t0 < 5000) {
+      await raf()
+      const a = performance.now()
+      fn(rec, cv)
+      costs.push(performance.now() - a)
+      ticks++
+    }
+    const dt = (performance.now() - t0) / 1000
+    const fin0 = performance.now()
+    const blob = await rec.finish()
+    res[label] = {
+      frameCallMs: stats(costs),
+      rafHz: +(ticks / dt).toFixed(1),
+      engineHz: +((window.vf.frameNo() - f0) / dt).toFixed(1),
+      frames: rec.frames(),
+      finishMs: +(performance.now() - fin0).toFixed(1),
+      mb: +(blob.size / 1e6).toFixed(2),
+      err: rec.error(),
+    }
+  }
+  await run('recordOnePerTick', (rec, c) => rec.frame(c))
+  await run('recordThreePerTick', (rec, c) => {
+    rec.frame(c)
+    rec.frame(c)
+    rec.frame(c)
+  })
+
+  // Readback alone vs a clone of the last frame, without an encoder.
+  const read = [],
+    clone = []
+  let last = null
+  for (let i = 0; i < 120; i++) {
+    await raf()
+    let a = performance.now()
+    const f = new VideoFrame(cv, { timestamp: i * 16667 })
+    read.push(performance.now() - a)
+    a = performance.now()
+    const c = new VideoFrame(f, { timestamp: i * 16667 + 1, duration: 16667 })
+    clone.push(performance.now() - a)
+    c.close()
+    last?.close()
+    last = f
+  }
+  last?.close()
+  res.readback = stats(read)
+  res.clone = stats(clone)
+  res.after = await rate(3000)
+  return res
+})
+console.log(JSON.stringify(out, null, 1))
+await browser.close()
diff --git a/scripts/spike-sum.py b/scripts/spike-sum.py
new file mode 100644
index 0000000..af91338
--- /dev/null
+++ b/scripts/spike-sum.py
@@ -0,0 +1,30 @@
+# Spike: one line per take from spike-take.mjs (and spike-avsync.mjs) output.
+#   node scripts/spike-take.mjs ... | python3 scripts/spike-sum.py <label>
+import json
+import sys
+
+label = sys.argv[1] if len(sys.argv) > 1 else ''
+for line in sys.stdin:
+    line = line.strip()
+    if not line.startswith('{'):
+        if 'error' in line.lower():
+            print(label, line[:300])
+        continue
+    try:
+        d = json.loads(line)
+    except Exception:
+        continue
+    if isinstance(d.get('frames'), dict):
+        f = d['frames']
+        print(label, 'canvas', d['canvas'], 'hz', d['before']['rafHz'], '->', d['during']['rafHz'],
+              'worstGap', d['during']['worstGapMs'], 'pool', d.get('pool'),
+              'arrived', f['arrived'], 'kept', f['kept'], 'qdrop', f['droppedQueue'],
+              'lat', f['arriveLatencyMs'], 'gaps', f['slotGaps'], 'slotNoise', f.get('slotNoise'), 'stop', d['stopToFileMs'], 'MB', d['mb'])
+    elif 'offsetMs' in d:
+        o = d['offsetMs']
+        print(label, 'MID', d.get('mid'), 'q1/q4', d.get('midFirstVsLast'), 'offset mean', o['mean'], 'drift/min', d['driftMsPerMin'],
+              'pairs', d['pairs'], '/', d['clicks'], 'bound', d.get('bound'), '1st', d.get('boundFirstHalf'), '2nd', d.get('boundSecondHalf'), d['streams'])
+    elif 'failed' in d:
+        print(label, 'FAILED', line[:400])
+    else:
